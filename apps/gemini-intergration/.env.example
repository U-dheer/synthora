# Example environment variables for running this app with Google GenAI (Gemini)
# Use either GOOGLE_API_KEY (Gemini Developer API / Studio) or Vertex AI settings.

# If using the Gemini Developer API (Google AI Studio API key):
GOOGLE_API_KEY=your_gemini_api_key_here

# OR: If using Vertex AI (recommended for production with Google Cloud auth):
# Set to true to use Vertex AI endpoints and provide project/location
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=your-google-cloud-location

# Optional: override the model used by the service (defaults to gemini-2.5-flash)
GOOGLE_AI_MODEL=gemini-2.5-flash

# App port (optional)
PORT=3000
