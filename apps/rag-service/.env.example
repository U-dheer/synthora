# Vector Database Configuration
VECTOR_DB_TYPE=faiss              # Options: faiss, pinecone
FAISS_INDEX_PATH=./data/faiss_index
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# Embedding Model Configuration
EMBEDDING_TYPE=local              # Options: local, openai, cohere
LOCAL_MODEL_PATH=~/.cache/huggingface/hub/models--sentence-transformers--all-MiniLM-L6-v2
OPENAI_API_KEY=                   # For production OpenAI embeddings
COHERE_API_KEY=                   # For production Cohere embeddings

# Gateway Service Configuration (CRITICAL - All requests go through here)
# RAG Service communicates with gateway, and users access RAG through gateway
GATEWAY_SERVICE_URL=http://localhost:3006

# Backend Service Endpoints (Relative to Gateway - RAG calls these via Gateway)
GEMINI_ENDPOINT=/gemini/gemini/make
LLAMA_ENDPOINT=/llama/hugging-face/chat
COHERE_ENDPOINT=/cohere/cohere/make
SUMMARIZER_ENDPOINT=/summarize/api/summarize/ai-prompts

# Application Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
REQUEST_TIMEOUT=30                # Timeout for Gateway requests
MAX_RETRIES=3                     # Retry failed Gateway requests

# FastAPI Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_RELOAD=true

# Logging
LOG_LEVEL=INFO
